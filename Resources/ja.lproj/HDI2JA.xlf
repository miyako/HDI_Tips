			<trans-unit id="AnimalRat" resname="AnimalRat"><source>Rat</source><target>ネズミ</target></trans-unit>
			<trans-unit id="AnimalMonkey" resname="AnimalMonkey"><source>Monkey</source><target>猿</target></trans-unit>
			<trans-unit id="AnimalElephant" resname="AnimalElephant"><source>Elephant</source><target>象</target></trans-unit>
			<trans-unit id="AnimalBear" resname="AnimalBear"><source>Bear</source><target>熊</target></trans-unit>
			<trans-unit id="AnimalPanther" resname="AnimalPanther"><source>Panther</source><target>ヒョウ</target></trans-unit>
			<trans-unit id="AnimalLion" resname="AnimalLion"><source>Lion</source><target>ライオン</target></trans-unit>
			<trans-unit id="AnimalFox" resname="AnimalFox"><source>Fox</source><target>キツネ</target></trans-unit>
			<trans-unit id="AnimalOwl" resname="AnimalOwl"><source>Owl</source><target>フクロウ</target></trans-unit>
			<trans-unit id="AnimalDuck" resname="AnimalDuck"><source>Duck</source><target>アヒル</target></trans-unit>
			<trans-unit id="AnimalHen" resname="AnimalHen"><source>Hen</source><target>雌鶏</target></trans-unit>
			<trans-unit id="AnimalFalcon" resname="AnimalFalcon"><source>Falcon</source><target>ハヤブサ</target></trans-unit>
		</body>
